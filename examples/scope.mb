# scope.mb - ámbitos de bloque, else if y estado global
let counter: int = 0;

fn bump() {
  counter = counter + 1;
}

fn grade(n: int) -> str {
  if (n >= 90) {
    return "A";
  } else if (n >= 80) {
    return "B";
  } else {
    return "C";
  }
}

let x: int = 1;
if (True) {
  let x: int = 2;      # sombrea a la x externa solo dentro de este bloque
  print(x);
}
print(x);

bump();
bump();
print(counter);
print(grade(95));
print(grade(85));
